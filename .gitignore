# downloaded credentials (ClickHouse Cloud, Google, other services)
*credentials*
*.credentials
client_secret*.json
service-account*.json
*-sa.json
token.json
# keys and certificates (e.g. the Oracle / SSH key you download)
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
ssh-key-*
