# ---------- Warehouse (ClickHouse) ----------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=adpulse
# Admin user: used for ingestion, transforms, app tables
CLICKHOUSE_USER=adpulse
CLICKHOUSE_PASSWORD=adpulse
# Read-only user: the ONLY credentials the agent's generated SQL runs with
CLICKHOUSE_READER_USER=adpulse_reader
CLICKHOUSE_READER_PASSWORD=change-me-reader

# ---------- LLM ----------
# anthropic | groq | openrouter
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high (Opus 5.5 defaults to medium)
ANTHROPIC_EFFORT=medium
# Re-run on a fallback model if the primary declines (server-side fallback beta)
ANTHROPIC_FALLBACKS=true

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5

# ---------- Reports ----------
# Slack: either a bot token + channel, or an incoming webhook URL
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#marketing-reports
SLACK_WEBHOOK_URL=
# Email (SMTP). Gmail: smtp.gmail.com + an App Password (myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls   # starttls (587) | ssl (465) | none
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

# ---------- Business rules for pause / scale suggestions ----------
TARGET_ROAS=2.0
TARGET_CAC=60
MIN_SPEND_FOR_DECISION=300

# Weekly report schedule (used by `adpulse scheduler` / the docker-compose "scheduler" service)
REPORT_SCHEDULE_DAY=mon
REPORT_SCHEDULE_TIME=08:00
REPORT_TIMEZONE=UTC
